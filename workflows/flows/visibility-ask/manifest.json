{
  "name": "visibility-ask",
  "version": "1.0.0",
  "domain": "marketing",
  "tags": [
    "ai-search",
    "measurement"
  ],
  "inputs": [
    "question_set"
  ],
  "outputs": [
    "answers"
  ],
  "execution_pattern": "phase_pipeline",
  "price": "0",
  "license": "PRIVATE",
